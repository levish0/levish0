ogged in and the article has a login barrier; unlocked: user logged in\n        return getCurrentLoginStatus() === \"logged_in\" ? \"unlocked\" : \"locked\";\n    }\n\n    function applyLoginDependentParameters() {\n        // Set login-dependent parameters at send time so they wait for the (async) login event\n        // and stay consistent with each other.\n        if (typeof wt === 'undefined' || typeof wt_event === 'undefined') {\n            return;\n        }\n\n        // cs2: login status of the current session.\n        wt.customSessionParameter = wt.customSessionParameter || {};\n        wt.customSessionParameter[2] = getLoginStatus();\n        wt_event.customSessionParameter = wt_event.customSessionParameter || {};\n        wt_event.customSessionParameter[2] = getLoginStatus();\n\n        // cp81: locked/unlocked, only relevant when the page has a login barrier.\n        if (hasProtectedContent()) {\n            wt.customParameter = wt.customParameter || {};\n            wt.customParameter[81] = getProtectedContentStatus();\n            wt_event.customParameter = wt_event.customParameter || {};\n            wt_event.customParameter[81] = getProtectedContentStatus();\n        }\n    }\n</script>\n\n\n\n\n<script type=\"text/javascript\">\n    (function (d, script) {\n        function initWt() {\n            window.webtrekkConfig = {\n                trackId: \"412666916963576\",\n                trackDomain: \"messefrankfurt01.webtrekk.net\",\n                domain: \"REGEXP:^.+\\\\.messefrankfurt\\\\.com$\",\n                cookie: \"1\"\n            };\n\n            var wt = new webtrekkV3({\n                linkTrack: \"link\",\n                heatmap: \"0\",\n                form: \"0\",\n                contentId: \"\"\n            });\n            wt.linkTrackDownloads = \"pdf;doc;ppt;xls;csv;ics;jpg\";\n\n            // Initial default; refreshed at send time in applyLoginDependentParameters() so it waits for the login event.\n            wt.cus