ey\":\"attarandrollonbottles\",\"productLink3d\":null,\"novelty\":false,\"pressRelease\":[{\"tag\":\"pressrelease\",\"placement\":\"product\",\"file\":\"document_downloads/10000053202601/AEXV8A00CGST/1728048134670_408095281.pdf\",\"headline\":null,\"subheadline\":null,\"filesize\":null,\"filetype\":null,\"htmltitle\":\"AGI Greenpac : Leader in Sustainable Packaging Solutions\"}],\"productSort\":3,\"deeplink\":\"\",\"nextradeDeeplink\":\"\",\"contentdownloads\":null,\"videocontents\":null,\"cmsvideocontents\":null}]},\"categories\":[{\"id\":\"mf_ppx_slx_9843775\",\"name\":\"6 Supply Chain & Services\",\"adLabel\":\"6 Supply Chain & Services\",\"booked\":true,\"sapProdId\":\"00006000000000000000\",\"subCategories\":null,\"exhibitors\":null,\"nrChildren\":1}],\"usageAreas\":[],\"productenduses\":[],\"otherExhibitions\":null,\"catalogExtraText\":[\"Product Range and Applications AGI Glaspac offers a wide array of specialty glass containers, with capacities ranging from as small as 1.5ml to as large as 6,000ml. Commercial and Personal Care: Perfume Bottles: Elegantly designed to add a touch of luxury, available in sizes from 10ml to 120ml. Foundation Bottles: Premium packaging designed to protect and highlight liquid foundations, with sizes from 12ml to 100ml. Cosmetic Jars: Stylish and functional jars for creams, lotions, and beauty treatments, ranging from 10g to 100g. Nail Polish Bottles: Sleek, durable glass containers designed to showcase vibrant nail colors, available from 4ml to 15ml. Attar Bottles: Distinctive bottles for storing fine liquors and attar, sized from 1.5ml to 12ml. Roll-on Bottles: Compact and elegant bottles for essential oils and perfumes, perfect for on-the-go applications, in 5ml to 8ml sizes. Diffuser Bottles: Beautifully crafted glass diffusers to enhance any room's ambiance, with capacities from 30ml to 1000ml. Air Freshener Bottles: Stylish glass car and home air fresheners available in 9ml and 60g sizes. Candle Jars: A variety of shapes and sizes from 3oz to 18oz, including compatible lids. Caps & Closure: Artsy collection of most premium and sustainable wooden and cork caps and closure for premium application. Advanced Decoration Capabilities AGI transforms glass packaging into works of art through a wide array of in-house decoration techniques, providing clients with a complete, single-point solution. Spray Coating: Offers unlimited possibilities including opaque, transparent, translucent, multicolor gradient, metallic, pearl, glossy, and frosted effects. Hot Foil Stamping (HFS): Adds a touch of elegance and luxury to plain, coated, or textured bottles, with holographic effects also available. Screen Printing: Allows for multicolor designs. Digital Printing: Capable of printing any design with any number of colors. Other Techniques: Including Acid Itching/Frosting for a velvety look, eco-friendly Decals, and durable Applied Ceramic Labels (ACL).\"],\"profileLabels\":{\"contentDownload\":{\"showLabel\":false,\"count\":0},\"shopLink\":{\"showLabel\":false,\"count\":0},\"videoContent\":null,\"socialMedia\":{\"showLabel\":true,\"count\":5},\"productDirectLink\":{\"showLabel\":false,\"count\":0},\"pressRelease\":{\"showLabel\":true,\"count\":1},\"jobOffer\":{\"showLabel\":false,\"count\":0},\"nextradeShoplink\":{\"showLabel\":false,\"count\":0},\"virtualShowroom\":{\"showLabel\":false,\"count\":0},\"productlink3D\":{\"showLabel\":false,\"count\":0},\"fairlink3D\":{\"showLabel\":false,\"count\":0},\"joblink\":{\"showLabel\":false,\"count\":0}},\"social\":[{\"network\":\"facebook\",\"url\":\"https://www.facebook.com/agiglaspacBU\",\"imageFile\":null},{\"network\":\"linkedin\",\"url\":\"https://www.linkedin.com/company/agi-greenpac\",\"imageFile\":null},{\"network\":\"twitter\",\"url\":\"https://x.com/AGIglaspac\",\"imageFile\":null},{\"network\":\"linkedin\",\"url\":\"https://www.linkedin.com/company/5426206/admin/feed/posts/\",\"imageFile\":null},{\"network\":\"linkedin\",\"url\":\"https://www.linkedin.co